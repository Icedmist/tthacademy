
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // ===============================================================
    // 1. HELPER FUNCTIONS
    // ===============================================================

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'dqrHnJtM27bMpNudHxO5hL3wsNE3' || 
        (exists(/databases/$(database)/documents/studentProgress/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/studentProgress/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Global bypass for the SuperAdmin during setup
    function isSuperAdmin() {
      return isSignedIn() && request.auth.uid == 'dqrHnJtM27bMpNudHxO5hL3wsNE3';
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isReadingPublicProfileData() {
      // Allows reading only a few public fields from a user's profile
      // This is used for features like showing a referrer's name.
      return isSignedIn() && (
        resource.data.keys().hasOnly(['studentId', 'name'])
      );
    }

    // ===============================================================
    // 2. PUBLIC CONTENT (Courses, Team, Blog, Events)
    // ===============================================================

    // COURSES: Allows reading the course AND all subcollections (lessons, quizzes, etc.)
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isAdmin();
      
      match /{allSubcollections=**} {
        allow read: if true;
        allow create, update, delete: if isSuperAdmin() || isAdmin();
      }
    }
    
    match /team/{memberId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }
    
    match /blogPosts/{postId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }

    // EVENTS
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isAdmin();
      
      // ATTENDEES SUBCOLLECTION
      match /attendees/{userId} {
        // Admins can see the full list of who is attending
        allow list: if isAdmin();
        
        // Users can check their own status; Admins can check anyone
        allow get: if isOwner(userId) || isAdmin();
        
        // Users can Register (create) AND Unregister (delete) themselves
        allow create, delete: if isOwner(userId);
        
        // Admins can force remove anyone
        allow delete: if isAdmin();
        
        // No updating allowed (delete and re-create if needed)
        allow update: if false; 
      }
    }

    // ===============================================================
    // 3. USER SPECIFIC DATA
    // ===============================================================

    // STUDENT PROGRESS
    match /studentProgress/{userId} {
      // Allow a user to read their own full profile
      // Allow any signed-in user to read only public fields (e.g., for referrals)
      allow get: if isOwner(userId) || isReadingPublicProfileData();

      // Only Admins can list all users
      allow list: if isAdmin();
      
      // User can create their own doc on signup.
      allow create: if isOwner(userId) || isSuperAdmin();
      
      // A user can update their own data.
      // An admin can update anyone's role.
      allow update: if isOwner(userId) || isAdmin() || isSuperAdmin();

      // Only admins or SuperAdmin can delete user profiles
      allow delete: if isSuperAdmin() || isAdmin();
    }

    // FEEDBACK
    match /feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }
  }
}
