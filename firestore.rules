
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // ===============================================================
    // 1. HELPER FUNCTIONS
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getRole() {
       return exists(/databases/$(database)/documents/studentProgress/$(request.auth.uid)) 
              ? get(/databases/$(database)/documents/studentProgress/$(request.auth.uid)).data.role 
              : 'student';
    }

    function isAdmin() {
      return isAuthenticated() && (
        getRole() == 'admin' || 
        request.auth.uid in ['dqrHnJtM27bMpNudHxO5hL3wsNE3']
      );
    }

    function isInstructor() {
      return isAuthenticated() && (getRole() == 'instructor' || isAdmin());
    }

    function isReadingPublicProfileData() {
      // Allows reading only a few public fields from a user's profile
      // We removed the strict hasOnly check to prevent blocking role resolution.
      return isAuthenticated();
    }

    // ===============================================================
    // 2. PUBLIC CONTENT (Courses, Team, Blog, Events)
    // ===============================================================

    // INSTRUCTORS
    match /instructors/{instructorId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // COURSES: Allows reading the course AND all subcollections (lessons, quizzes, etc.)
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      
      // Recursive match for any subcollections inside a course
      match /{allSubcollections=**} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }
    
    match /team/{memberId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /blogPosts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // EVENTS
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      
      // ATTENDEES SUBCOLLECTION
      match /attendees/{userId} {
        allow list: if isAdmin();
        allow get: if isOwner(userId) || isAdmin();
        allow create, delete: if isOwner(userId);
        allow delete: if isAdmin();
        allow update: if false; 
      }
    }

    // ===============================================================
    // 3. USER SPECIFIC DATA
    // ===============================================================

    // STUDENT PROGRESS
    match /studentProgress/{userId} {
      // Admins and Instructors can read any profile for management purposes
      // Users can read their own profile
      allow get: if isOwner(userId) || isAdmin() || isInstructor() || isReadingPublicProfileData();

      // Only Admins or Instructors can list all users
      allow list: if isAdmin() || isInstructor();
      
      allow create: if isOwner(userId);
      
      allow update: if isOwner(userId) || isAdmin();

      allow delete: if isAdmin();
    }

    // FEEDBACK
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // Assessment Submissions
    match /assessmentSubmissions/{submissionId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) || 
        isAdmin() || 
        isInstructor()
      );
      allow create: if isAuthenticated() && 
                    isOwner(request.resource.data.userId) &&
                    request.resource.data.status == 'pending';
      allow update: if isAuthenticated() && (
        isAdmin() || 
        isInstructor()
      );
    }
  }
}
